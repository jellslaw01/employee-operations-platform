# Node.js Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=db        #uncomment this line if you are using Docker Compose and the database service is named 'db'
#DB_HOST=localhost
DB_PORT=5432
DB_NAME=employee_app
DB_USER=postgres
DB_PASSWORD=postgres123

# Postgres Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=employee_app

# Security
# DEVELOPMENT ONLY: replace both values with strong, unique secrets before production.
# These local values work with both Docker Compose and direct local development.
JWT_SECRET=local-jwt-secret-change-me
SECRET_WORD=local-admin-secret-change-me

# CORS Configuration (allows frontend to access backend)
CORS_ORIGIN=*
